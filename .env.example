# Copy to .env.local and fill in. Never commit real values.

# Webhook that triggers the website audit workflow (screenshot capture ->
# analysis -> scored report -> email). Used ONLY by the server-side route at
# src/app/api/audit/route.ts.
#
# Intentionally NOT prefixed NEXT_PUBLIC_: that prefix would inline the value
# into the client bundle and expose the endpoint to anyone viewing source.
# The browser only ever calls /api/audit.
AUDIT_WEBHOOK_URL=https://example.app.n8n.cloud/webhook/replace-me

# Returns the list of recent audits shown on /webcriticapp (domain, score,
# date). Read only by src/app/api/recent-audits/route.ts. Same rule: no
# NEXT_PUBLIC_ prefix, so it never reaches the browser.
#
# If this is unset the section simply does not render — the audit form still
# works, and the reason is logged server-side.
RECENT_AUDITS_WEBHOOK_URL=https://example.app.n8n.cloud/webhook/replace-me-too

# Shared secret n8n must send as the X-Callback-Secret header when it calls
# POST /api/audit-complete. That endpoint has to be publicly reachable for n8n
# to reach it, so this secret is the only thing preventing anyone from writing
# arbitrary report content into a job. Use a long random value and set the
# identical string on the n8n side.
#
# If this is unset the callback route refuses every request (503) rather than
# accepting unauthenticated writes.
CALLBACK_SECRET=replace-with-a-long-random-string

# ── Job store ───────────────────────────────────────────────────────────────
# Provided automatically by the Upstash Redis integration (Vercel Marketplace).
# Note the names: the integration injects KV_-prefixed variables, NOT
# UPSTASH_REDIS_REST_*, so Redis.fromEnv() would not find them — see
# src/lib/auditStore.ts, which reads these explicitly and accepts either set.
KV_REST_API_URL=
KV_REST_API_TOKEN=
